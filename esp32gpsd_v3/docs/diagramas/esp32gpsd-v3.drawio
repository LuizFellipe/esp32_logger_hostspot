        <mxCell id="core1-title" value="CORE 1 / APLICAÇÃO" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=DejaVu Sans Mono;fontSize=17;fontColor=#354D6B;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="536" y="187" width="599" height="30" />
