        <mxCell id="recover" value="&lt;b&gt;Recuperação automática&lt;/b&gt;&lt;br&gt;&lt;br&gt;Watchdog loopTask: 60 s&lt;br&gt;Falha SD: retry / remount; 10 falhas → reset&lt;br&gt;Falha AP: ir ao sono; próximo check tenta&lt;br&gt;MPU ausente: continuar sem IMU" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF2D9;strokeColor=#A36A15;strokeWidth=1.5;fontColor=#17324F;fontFamily=Noto Sans;fontSize=17;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=12;spacingBottom=12;" vertex="1" parent="1">
