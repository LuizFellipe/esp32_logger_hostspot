          <mxGeometry as="geometry" x="60" y="440" width="460" height="150" />
        </mxCell>
        <mxCell id="wait" value="&lt;b&gt;Após foco: retomar loop&lt;/b&gt;&lt;br&gt;&lt;br&gt;Volta aquisição / timers / Serial&lt;br&gt;Sem atividade por 5 min e&lt;br&gt;sem download → fechar AP" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E4F3F4;strokeColor=#167580;strokeWidth=1.5;fontColor=#17324F;fontFamily=Noto Sans;fontSize=17;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=12;spacingBottom=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="735" width="460" height="150" />
        </mxCell>
        <mxCell id="sleep" value="&lt;b&gt;PARADO_SONO / 5 min&lt;/b&gt;&lt;br&gt;&lt;br&gt;Tentativa de flush&lt;br&gt;Fim do intervalo → CHECK&lt;br&gt;Próximo scan religa NimBLE" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EFF3F8;strokeColor=#354D6B;strokeWidth=1.5;fontColor=#17324F;fontFamily=Noto Sans;fontSize=17;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=12;spacingBottom=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="570" y="735" width="460" height="150" />
        </mxCell>
        <mxCell id="fail" value="&lt;b&gt;Falha AP ou tarefa HTTP&lt;/b&gt;&lt;br&gt;&lt;br&gt;AP falhou → WIFI_STA&lt;br&gt;Sem tarefa → hotspot desabilitado&lt;br&gt;CHECK vai ao sono; logger continua" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF2D9;strokeColor=#A36A15;strokeWidth=1.5;fontColor=#17324F;fontFamily=Noto Sans;fontSize=17;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=12;spacingBottom=12;" vertex="1" parent="1">
