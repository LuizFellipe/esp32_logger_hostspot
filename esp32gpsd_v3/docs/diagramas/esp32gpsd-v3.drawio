        </mxCell>
        <mxCell id="source" value="Fonte: esp32gpsd_v3.ino:95–146, 643–706, 1229–1341, 1467–1547" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=DejaVu Sans Mono;fontSize=13;fontColor=#52667B;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="48" y="1021" width="1500" height="25" />
