        </mxCell>
        <mxCell id="act" value="&lt;b&gt;Atividade válida&lt;/b&gt;&lt;br&gt;&lt;br&gt;Abrir / atualizar página ou baixar&lt;br&gt;renova ultimaAtividade&lt;br&gt;Só conectar no AP não renova" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E4F3F4;strokeColor=#167580;strokeWidth=1.5;fontColor=#17324F;fontFamily=Noto Sans;fontSize=17;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=12;spacingBottom=12;" vertex="1" parent="1">
