          <mxGeometry as="geometry" x="64" y="61" width="1450" height="43" />
        </mxCell>
        <mxCell id="sub" value="Três arquivos locais; dados numéricos com unidades explícitas e timestamp normalizado em UTC−3." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Noto Sans;fontSize=16;fontColor=#52667B;fontStyle=0;" vertex="1" parent="1">
