        </mxCell>
        <mxCell id="scope-build" value="&lt;b&gt;Uso real das dependências&lt;/b&gt;&lt;br&gt;&lt;br&gt;GFX / SSD1306 no manifesto, mas fora da v3.&lt;br&gt;WiFi + NimBLE exigem APP maior que padrão.&lt;br&gt;Não há display OLED, SIM800L ou backend nesta v3." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF2D9;strokeColor=#A36A15;strokeWidth=1.5;fontColor=#17324F;fontFamily=Noto Sans;fontSize=17;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=12;spacingBottom=12;" vertex="1" parent="1">
