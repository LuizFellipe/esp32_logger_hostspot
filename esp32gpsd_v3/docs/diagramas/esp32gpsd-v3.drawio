        <mxCell id="join" value="&lt;b&gt;atualizarCicloRadio() / junção&lt;/b&gt;&lt;br&gt;&lt;br&gt;wifiDone &amp;amp;&amp;amp; bleDone → fechar ciclo; guardar ultimoCicloFim.&lt;br&gt;Em PARADO_CHECK → entrarModoParadoHotspot(); em movimento → aguardar novo RMC e ≥30 s." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EFF3F8;strokeColor=#354D6B;strokeWidth=1.5;fontColor=#17324F;fontFamily=Noto Sans;fontSize=17;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=12;spacingBottom=12;" vertex="1" parent="1">
