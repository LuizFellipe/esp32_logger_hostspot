        <mxCell id="sub" value="loopTask e Hotspot_HTTP compartilham core 1; pilhas do core/IDF atendem rádio em seus contextos." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Noto Sans;fontSize=16;fontColor=#52667B;fontStyle=0;" vertex="1" parent="1">
