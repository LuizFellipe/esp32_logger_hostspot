        <mxCell id="wifi" value="&lt;b&gt;varrerWiFi()&lt;/b&gt;&lt;br&gt;&lt;br&gt;scanNetworks(true, true)&lt;br&gt;Assíncrono; incluir SSIDs ocultos&lt;br&gt;Poll scanComplete() no serviço" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F0ECFB;strokeColor=#7157A0;strokeWidth=1.5;fontColor=#17324F;fontFamily=Noto Sans;fontSize=17;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=12;spacingBottom=12;" vertex="1" parent="1">
