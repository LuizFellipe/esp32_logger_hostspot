        <mxCell id="root" value="&lt;b&gt;GET / • httpRaiz()&lt;/b&gt;&lt;br&gt;&lt;br&gt;HTML5 + CSS embutido&lt;br&gt;Sem JS / recursos externos / API&lt;br&gt;Resposta chunked • Cache-Control no-store" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E4F3F4;strokeColor=#167580;strokeWidth=1.5;fontColor=#17324F;fontFamily=Noto Sans;fontSize=17;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=12;spacingBottom=12;" vertex="1" parent="1">
