        </mxCell>
        <mxCell id="req" value="&lt;b&gt;Receber requisição&lt;/b&gt;&lt;br&gt;&lt;br&gt;DownloadEstado != OCIOSO → 503&lt;br&gt;Allowlist: log.txt / wifi.txt / ble.txt&lt;br&gt;Nome fora da lista → 400" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E4F3F4;strokeColor=#167580;strokeWidth=1.5;fontColor=#17324F;fontFamily=Noto Sans;fontSize=17;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=12;spacingBottom=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="190" width="460" height="150" />
        </mxCell>
        <mxCell id="open" value="&lt;b&gt;Validar sob sdMutex&lt;/b&gt;&lt;br&gt;&lt;br&gt;Lock até 2 s → ocupado: 503&lt;br&gt;Volume/off/open falhou: 503&lt;br&gt;Arquivo ausente: 404" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E7F3ED;strokeColor=#287452;strokeWidth=1.5;fontColor=#17324F;fontFamily=Noto Sans;fontSize=17;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=12;spacingBottom=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="570" y="190" width="460" height="150" />
        </mxCell>
        <mxCell id="header" value="&lt;b&gt;Abrir e enviar headers&lt;/b&gt;&lt;br&gt;&lt;br&gt;Tamanho ≤4.294.967.295 B&lt;br&gt;Maior → 503; downloadAtivo=true&lt;br&gt;Content-Length / attachment / no-store" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E4F3F4;strokeColor=#167580;strokeWidth=1.5;fontColor=#17324F;fontFamily=Noto Sans;fontSize=17;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=12;spacingBottom=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1080" y="190" width="460" height="150" />
        </mxCell>
        <mxCell id="read" value="&lt;b&gt;Ler bloco do arquivo&lt;/b&gt;&lt;br&gt;&lt;br&gt;Blocos de até 2048 B&lt;br&gt;sdMutex só durante f.read()&lt;br&gt;Leitura curta → abortar" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E7F3ED;strokeColor=#287452;strokeWidth=1.5;fontColor=#17324F;fontFamily=Noto Sans;fontSize=17;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=12;spacingBottom=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1080" y="445" width="460" height="150" />
        </mxCell>
        <mxCell id="send" value="&lt;b&gt;Enviar via NetworkClient&lt;/b&gt;&lt;br&gt;&lt;br&gt;client.write() pode ser parcial&lt;br&gt;Atualizar bytes / último progresso&lt;br&gt;Sem escrita → stalls++; delay 2 ms" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E4F3F4;strokeColor=#167580;strokeWidth=1.5;fontColor=#17324F;fontFamily=Noto Sans;fontSize=17;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=12;spacingBottom=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="570" y="445" width="460" height="150" />
        </mxCell>
        <mxCell id="abort" value="&lt;b&gt;Condição de aborto&lt;/b&gt;&lt;br&gt;&lt;br&gt;AP fechado ou desconexão&lt;br&gt;15 s sem progresso&lt;br&gt;Erro leitura SD" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF2D9;strokeColor=#A36A15;strokeWidth=1.5;fontColor=#17324F;fontFamily=Noto Sans;fontSize=17;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=12;spacingBottom=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="445" width="460" height="150" />
        </mxCell>
        <mxCell id="close" value="&lt;b&gt;Encerrar sob sdMutex&lt;/b&gt;&lt;br&gt;&lt;br&gt;f.close() • downloadAtivo=false&lt;br&gt;client.stop()&lt;br&gt;Renovar ultimaAtividade" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E7F3ED;strokeColor=#287452;strokeWidth=1.5;fontColor=#17324F;fontFamily=Noto Sans;fontSize=17;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=12;spacingBottom=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="745" width="460" height="150" />
        </mxCell>
        <mxCell id="result" value="&lt;b&gt;Resultado atômico&lt;/b&gt;&lt;br&gt;&lt;br&gt;Concluído: sem motivo, close OK&lt;br&gt;e bytes enviados = total&lt;br&gt;Caso contrário: DOWNLOAD_ERRO" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E4F3F4;strokeColor=#167580;strokeWidth=1.5;fontColor=#17324F;fontFamily=Noto Sans;fontSize=17;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=12;spacingBottom=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="570" y="745" width="460" height="150" />
        </mxCell>
        <mxCell id="print" value="&lt;b&gt;loopTask imprime transição&lt;/b&gt;&lt;br&gt;&lt;br&gt;[OK ] / [ERR]: bytes / duração&lt;br&gt;Motivo / stalls / heap / maxblk&lt;br&gt;Liberar estado para novo download" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EFF3F8;strokeColor=#354D6B;strokeWidth=1.5;fontColor=#17324F;fontFamily=Noto Sans;fontSize=17;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=12;spacingBottom=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1080" y="745" width="460" height="150" />
        </mxCell>
        <mxCell id="e1" value="nome permitido" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.7;strokeColor=#354D6B;fontFamily=Noto Sans;fontSize=13;fontColor=#17324F;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="req" target="open">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e2" value="SD / arquivo OK" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.7;strokeColor=#354D6B;fontFamily=Noto Sans;fontSize=13;fontColor=#17324F;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="open" target="header">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.7;strokeColor=#354D6B;fontFamily=Noto Sans;fontSize=13;fontColor=#17324F;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="header" target="read">
          <mxGeometry as="geometry" relative="1" />
