        <mxCell id="wdone" value="&lt;b&gt;WiFi finalizado&lt;/b&gt;&lt;br&gt;&lt;br&gt;Resultado ≥0 → dedup + wifiBuffer&lt;br&gt;scanDelete(); scanEmAndamento=false&lt;br&gt;Falha → flag; wifiDone=true" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F0ECFB;strokeColor=#7157A0;strokeWidth=1.5;fontColor=#17324F;fontFamily=Noto Sans;fontSize=17;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=12;spacingBottom=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="90" y="620" width="620" height="135" />
        </mxCell>
        <mxCell id="ble" value="&lt;b&gt;bleScanLigar()&lt;/b&gt;&lt;br&gt;&lt;br&gt;Reiniciar NimBLE se necessário&lt;br&gt;Scan ativo: 5000 ms&lt;br&gt;Callbacks não reiniciam scan" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F0ECFB;strokeColor=#7157A0;strokeWidth=1.5;fontColor=#17324F;fontFamily=Noto Sans;fontSize=17;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=12;spacingBottom=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="890" y="425" width="620" height="135" />
        </mxCell>
        <mxCell id="bdone" value="&lt;b&gt;BLE finalizado&lt;/b&gt;&lt;br&gt;&lt;br&gt;onScanEnd → flags atômicas&lt;br&gt;loopTask drena fila; bleDone=true&lt;br&gt;Falha start → bleDone=true" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F0ECFB;strokeColor=#7157A0;strokeWidth=1.5;fontColor=#17324F;fontFamily=Noto Sans;fontSize=17;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=12;spacingBottom=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="890" y="620" width="620" height="135" />
