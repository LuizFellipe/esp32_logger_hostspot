        <mxCell id="e4" value="bytes lidos" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.7;strokeColor=#354D6B;fontFamily=Noto Sans;fontSize=13;fontColor=#17324F;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="read" target="send">
