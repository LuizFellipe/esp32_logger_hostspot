  <diagram id="08-deduplicacao" name="Fila BLE e deduplicação por hash">
    <mxGraphModel dx="1600" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="sheet" value="" style="fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="0" y="0" width="1600" height="1100" />
        </mxCell>
        <mxCell id="accent" value="" style="fillColor=#2864A0;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="38" width="8" height="91" />
        </mxCell>
        <mxCell id="kicker" value="ESP32 GPS LOGGER / V3 / ATLAS TÉCNICO" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=DejaVu Sans Mono;fontSize=14;fontColor=#2864A0;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="64" y="32" width="1450" height="25" />
        </mxCell>
        <mxCell id="title" value="Fila BLE e deduplicação por hash" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Ubuntu Sans;fontSize=30;fontColor=#17324F;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="64" y="61" width="1450" height="43" />
        </mxCell>
        <mxCell id="sub" value="Callback produz registros sem bloquear; loopTask é dona da formatação, caches e buffers." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Noto Sans;fontSize=16;fontColor=#52667B;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="64" y="111" width="1450" height="37" />
        </mxCell>
        <mxCell id="footerline" value="" style="fillColor=#DCE4ED;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="48" y="1006" width="1504" height="1" />
        </mxCell>
        <mxCell id="source" value="Fonte: esp32gpsd_v3.ino:286–311, 622–706, 579–611" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=DejaVu Sans Mono;fontSize=13;fontColor=#52667B;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="48" y="1021" width="1500" height="25" />
        </mxCell>
        <mxCell id="scope" value="SENSOR  azul     RÁDIO  violeta     SD  verde     HTTP  petróleo     CONDIÇÃO / FALHA  âmbar  •  Snapshot 06/10/2026" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Noto Sans;fontSize=13;fontColor=#52667B;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="48" y="1050" width="1500" height="24" />
        </mxCell>
        <mxCell id="cb" value="&lt;b&gt;NimBLE onResult()&lt;/b&gt;&lt;br&gt;&lt;br&gt;malloc BLEDeviceRecord&lt;br&gt;MAC / nome até 64 / RSSI / TX&lt;br&gt;Falha malloc → perdas++" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F0ECFB;strokeColor=#7157A0;strokeWidth=1.5;fontColor=#17324F;fontFamily=Noto Sans;fontSize=17;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=12;spacingBottom=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="65" y="195" width="440" height="145" />
        </mxCell>
        <mxCell id="q" value="&lt;b&gt;FreeRTOS bleQueue&lt;/b&gt;&lt;br&gt;&lt;br&gt;10 ponteiros • xQueueSend(...,0)&lt;br&gt;Fila cheia → free + perdas++&lt;br&gt;Filtro nativo reduz duplicatas" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F0ECFB;strokeColor=#7157A0;strokeWidth=1.5;fontColor=#17324F;fontFamily=Noto Sans;fontSize=17;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=12;spacingBottom=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="580" y="195" width="440" height="145" />
        </mxCell>
        <mxCell id="drain" value="&lt;b&gt;drenarFilaBLE()&lt;/b&gt;&lt;br&gt;&lt;br&gt;xQueueReceive(...,0)&lt;br&gt;dashBle++ para cada consumido&lt;br&gt;Ao final: free(rec)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F0ECFB;strokeColor=#7157A0;strokeWidth=1.5;fontColor=#17324F;fontFamily=Noto Sans;fontSize=17;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=12;spacingBottom=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1095" y="195" width="440" height="145" />
        </mxCell>
        <mxCell id="key" value="&lt;b&gt;Identificador observado&lt;/b&gt;&lt;br&gt;&lt;br&gt;WiFi: SSID, não BSSID&lt;br&gt;BLE: endereço MAC&lt;br&gt;Calcula FNV-1a 32 bits" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EFF3F8;strokeColor=#354D6B;strokeWidth=1.5;fontColor=#17324F;fontFamily=Noto Sans;fontSize=17;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=12;spacingBottom=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1095" y="455" width="440" height="145" />
        </mxCell>
        <mxCell id="cache" value="&lt;b&gt;Hash já visto?&lt;/b&gt;&lt;br&gt;&lt;br&gt;Busca linear em cache RTC&lt;br&gt;SSID 500 / MAC BLE 500&lt;br&gt;Conhecido → ignorar CSV" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EFF3F8;strokeColor=#354D6B;strokeWidth=1.5;fontColor=#17324F;fontFamily=Noto Sans;fontSize=17;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=12;spacingBottom=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="580" y="455" width="440" height="145" />
        </mxCell>
        <mxCell id="buf" value="&lt;b&gt;Novo → cache + CSV&lt;/b&gt;&lt;br&gt;&lt;br&gt;Adiciona hash antes do flush&lt;br&gt;Carimba última posição/hora&lt;br&gt;Buffer circular WiFi ou BLE" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E7F3ED;strokeColor=#287452;strokeWidth=1.5;fontColor=#17324F;fontFamily=Noto Sans;fontSize=17;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=12;spacingBottom=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="65" y="455" width="440" height="145" />
        </mxCell>
        <mxCell id="e1" value="ponteiro" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.7;strokeColor=#7157A0;fontFamily=Noto Sans;fontSize=13;fontColor=#17324F;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="cb" target="q">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e2" value="consumo no loop" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.7;strokeColor=#7157A0;fontFamily=Noto Sans;fontSize=13;fontColor=#17324F;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="q" target="drain">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e3" value="MAC" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.7;strokeColor=#7157A0;fontFamily=Noto Sans;fontSize=13;fontColor=#17324F;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="drain" target="key">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e4" value="hash" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.7;strokeColor=#354D6B;fontFamily=Noto Sans;fontSize=13;fontColor=#17324F;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="key" target="cache">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e5" value="não visto" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.7;strokeColor=#287452;fontFamily=Noto Sans;fontSize=13;fontColor=#17324F;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="cache" target="buf">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="full" value="&lt;b&gt;Cache cheia&lt;/b&gt;&lt;br&gt;&lt;br&gt;Aviso único. Conhecidos continuam filtrados.&lt;br&gt;Novos IDs geram CSV, mas não entram no cache." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF2D9;strokeColor=#A36A15;strokeWidth=1.5;fontColor=#17324F;fontFamily=Noto Sans;fontSize=17;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=12;spacingBottom=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="65" y="735" width="440" height="165" />
        </mxCell>
        <mxCell id="rtc" value="&lt;b&gt;Retenção RTC&lt;/b&gt;&lt;br&gt;&lt;br&gt;Caches e bootCount usam RTC_DATA_ATTR.&lt;br&gt;Intenção: reter em resets, não power-off.&lt;br&gt;Retenção real depende do tipo de reset." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF2D9;strokeColor=#A36A15;strokeWidth=1.5;fontColor=#17324F;fontFamily=Noto Sans;fontSize=17;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=12;spacingBottom=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="580" y="735" width="440" height="165" />
        </mxCell>
        <mxCell id="limit" value="&lt;b&gt;Limites de deduplicação&lt;/b&gt;&lt;br&gt;&lt;br&gt;Hash 32 bits pode colidir. SSID igual agrupa redes.&lt;br&gt;Hash é inserido antes de escrita confirmada: perda&lt;br&gt;de buffer não garante reobservação do registro." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF2D9;strokeColor=#A36A15;strokeWidth=1.5;fontColor=#17324F;fontFamily=Noto Sans;fontSize=17;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=12;spacingBottom=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1095" y="735" width="440" height="165" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="09-armazenamento" name="Buffers, flush e recuperação do SD">
    <mxGraphModel dx="1600" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0" background="#FFFFFF">
      <root>
