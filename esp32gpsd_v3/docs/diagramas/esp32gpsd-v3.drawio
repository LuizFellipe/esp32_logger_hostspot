          <mxGeometry as="geometry" x="64" y="61" width="1450" height="43" />
        </mxCell>
        <mxCell id="sub" value="Histerese controla transições por RMC válido; servicoModo() controla tempo e fechamento dos ciclos." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Noto Sans;fontSize=16;fontColor=#52667B;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="64" y="111" width="1450" height="37" />
        </mxCell>
        <mxCell id="footerline" value="" style="fillColor=#DCE4ED;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="48" y="1006" width="1504" height="1" />
        </mxCell>
        <mxCell id="source" value="Fonte: esp32gpsd_v3.ino:764–949, 963–1011, 1459–1474" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=DejaVu Sans Mono;fontSize=13;fontColor=#52667B;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="48" y="1021" width="1500" height="25" />
        </mxCell>
        <mxCell id="scope" value="SENSOR  azul     RÁDIO  violeta     SD  verde     HTTP  petróleo     CONDIÇÃO / FALHA  âmbar  •  Snapshot 06/10/2026" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Noto Sans;fontSize=13;fontColor=#52667B;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="48" y="1050" width="1500" height="24" />
        </mxCell>
        <mxCell id="mov" value="&lt;b&gt;MOVIMENTO / 0&lt;/b&gt;&lt;br&gt;&lt;br&gt;RMC válido dispara ciclo após ≥30 s&lt;br&gt;desde fim anterior. CSV: 10 s.&lt;br&gt;WiFi STA + BLE quando escaneia." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F0ECFB;strokeColor=#7157A0;strokeWidth=1.5;fontColor=#17324F;fontFamily=Noto Sans;fontSize=17;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=12;spacingBottom=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="90" y="230" width="560" height="160" />
        </mxCell>
        <mxCell id="check" value="&lt;b&gt;PARADO_CHECK / 3&lt;/b&gt;&lt;br&gt;&lt;br&gt;Ao parar: reaproveitar ciclo aberto&lt;br&gt;ou iniciar ciclo final WiFi+BLE.&lt;br&gt;Ao acordar: iniciar ciclo único." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F0ECFB;strokeColor=#7157A0;strokeWidth=1.5;fontColor=#17324F;fontFamily=Noto Sans;fontSize=17;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=12;spacingBottom=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="940" y="230" width="560" height="160" />
        </mxCell>
        <mxCell id="sono" value="&lt;b&gt;PARADO_SONO / 2&lt;/b&gt;&lt;br&gt;&lt;br&gt;5 min sem scan • tentativa de flush&lt;br&gt;Sono lógico: sem deep sleep.&lt;br&gt;Aquisição continua fora do foco." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EFF3F8;strokeColor=#354D6B;strokeWidth=1.5;fontColor=#17324F;fontFamily=Noto Sans;fontSize=17;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=12;spacingBottom=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="90" y="640" width="560" height="160" />
        </mxCell>
        <mxCell id="hot" value="&lt;b&gt;PARADO_HOTSPOT / 4&lt;/b&gt;&lt;br&gt;&lt;br&gt;Flush → drenar fila → BLE deinit&lt;br&gt;AP: 5 min sem ação HTTP válida&lt;br&gt;CSV parado: 30 s, fora do foco." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E4F3F4;strokeColor=#167580;strokeWidth=1.5;fontColor=#17324F;fontFamily=Noto Sans;fontSize=17;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=12;spacingBottom=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="940" y="640" width="560" height="160" />
        </mxCell>
        <mxCell id="e1" value="km/h ≤2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.7;strokeColor=#7157A0;fontFamily=Noto Sans;fontSize=13;fontColor=#17324F;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="mov" target="check">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e2" value="WiFi done + BLE done" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.7;strokeColor=#167580;fontFamily=Noto Sans;fontSize=13;fontColor=#17324F;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="check" target="hot">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e3" value="5 min inativo; sem download" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.7;strokeColor=#167580;fontFamily=Noto Sans;fontSize=13;fontColor=#17324F;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="hot" target="sono">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e4" value="5 min desde entrada" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.7;strokeColor=#7157A0;fontFamily=Noto Sans;fontSize=13;fontColor=#17324F;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;entryX=0.15;entryY=1;exitPerimeter=1;entryPerimeter=1;" edge="1" parent="1" source="sono" target="check">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="370" y="495" />
              <mxPoint x="1024" y="495" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e5" value="HTTP indisponível / AP falhou" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.7;strokeColor=#A36A15;fontFamily=Noto Sans;fontSize=13;fontColor=#17324F;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;exitX=0;exitY=0.55;entryX=1;entryY=0.3;exitPerimeter=1;entryPerimeter=1;" edge="1" parent="1" source="check" target="sono">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="830" y="318" />
              <mxPoint x="830" y="688" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="return" value="&lt;b&gt;Qualquer estado parado → MOVIMENTO&lt;/b&gt;&lt;br&gt;&lt;br&gt;&amp;gt;5 km/h por 5 RMCs válidos consecutivos; leitura ≤5 zera contador.&lt;br&gt;Ao sair do HOTSPOT: fechar AP; próximo scan reinicializa BLE." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF2D9;strokeColor=#A36A15;strokeWidth=1.5;fontColor=#17324F;fontFamily=Noto Sans;fontSize=17;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=12;spacingBottom=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="855" width="790" height="110" />
        </mxCell>
        <mxCell id="fresh" value="&lt;b&gt;GPS e foco HTTP&lt;/b&gt;&lt;br&gt;&lt;br&gt;Sem RMC válido, modo permanece; velocidade fica obsoleta em 3 s.&lt;br&gt;No foco HTTP, UART é descartada: movimento não é detectado." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF2D9;strokeColor=#A36A15;strokeWidth=1.5;fontColor=#17324F;fontFamily=Noto Sans;fontSize=17;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=12;spacingBottom=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="900" y="855" width="630" height="110" />
        </mxCell>
        <mxCell id="e6" value="&amp;gt;5 ×5 RMCs" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.7;strokeColor=#2864A0;fontFamily=Noto Sans;fontSize=13;fontColor=#17324F;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;exitX=0;exitY=0.5;entryX=0;entryY=0.5;exitPerimeter=1;entryPerimeter=1;" edge="1" parent="1" source="sono" target="mov">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="52" y="720" />
              <mxPoint x="52" y="310" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="resume" value="HOTSPOT/CHECK → MOVIMENTO seguem a mesma regra; download só aborta por movimento se a transição puder ser detectada." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Noto Sans;fontSize=16;fontColor=#17324F;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="90" y="170" width="1410" height="40" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
