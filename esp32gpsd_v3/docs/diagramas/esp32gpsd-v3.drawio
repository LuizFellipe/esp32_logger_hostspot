        </mxCell>
        <mxCell id="sd" value="&lt;b&gt;sdMutex / SdFs&lt;/b&gt;&lt;br&gt;&lt;br&gt;Flush/remount no loop&lt;br&gt;HTTP: listagem e leitura&lt;br&gt;Serializa operações SD" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E7F3ED;strokeColor=#287452;strokeWidth=1.5;fontColor=#17324F;fontFamily=Noto Sans;fontSize=17;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=12;spacingBottom=12;" vertex="1" parent="1">
