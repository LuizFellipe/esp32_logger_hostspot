        </mxCell>
        <mxCell id="kicker" value="ESP32 GPS LOGGER / V3 / ATLAS TÉCNICO" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=DejaVu Sans Mono;fontSize=14;fontColor=#2864A0;fontStyle=0;" vertex="1" parent="1">
