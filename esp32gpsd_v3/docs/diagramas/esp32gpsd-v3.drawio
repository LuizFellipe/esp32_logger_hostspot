        <mxCell id="ap" value="&lt;b&gt;Abrir AP&lt;/b&gt;&lt;br&gt;&lt;br&gt;WIFI_AP • 192.168.4.1/24&lt;br&gt;ESP32GPS-Logs • canal 1&lt;br&gt;Máximo 1 estação • senha configurada" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E4F3F4;strokeColor=#167580;strokeWidth=1.5;fontColor=#17324F;fontFamily=Noto Sans;fontSize=17;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=12;spacingBottom=12;" vertex="1" parent="1">
