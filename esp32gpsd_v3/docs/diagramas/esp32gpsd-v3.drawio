          <mxGeometry as="geometry" x="48" y="175" width="485" height="660" />
        </mxCell>
        <mxCell id="g-title" value="GPS / NMEA" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=DejaVu Sans Mono;fontSize=17;fontColor=#2864A0;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="66" y="187" width="449" height="30" />
        </mxCell>
        <mxCell id="i" value="" style="rounded=1;arcSize=4;fillColor=#EAF3FF;fillOpacity=35;strokeColor=#2864A0;strokeOpacity=35;strokeWidth=1;" vertex="1" parent="1">
