        <mxCell id="dash" value="&lt;b&gt;Snapshots / métricas&lt;/b&gt;&lt;br&gt;&lt;br&gt;DHT / scans: volatile&lt;br&gt;Estado HTTP: atomic&lt;br&gt;Página usa últimos valores" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EFF3F8;strokeColor=#354D6B;strokeWidth=1.5;fontColor=#17324F;fontFamily=Noto Sans;fontSize=17;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=12;spacingBottom=12;" vertex="1" parent="1">
