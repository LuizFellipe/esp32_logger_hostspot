        <mxCell id="core0" value="" style="rounded=1;arcSize=4;fillColor=#F0ECFB;fillOpacity=35;strokeColor=#7157A0;strokeOpacity=35;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="48" y="175" width="440" height="760" />
        </mxCell>
        <mxCell id="core0-title" value="PILHAS DE RÁDIO / CONTEXTO IDF" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=DejaVu Sans Mono;fontSize=17;fontColor=#7157A0;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="66" y="187" width="404" height="30" />
