        <mxCell id="sub" value="Validade do NMEA, idade da velocidade e validação de calendário precedem gravação de telemetria." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Noto Sans;fontSize=16;fontColor=#52667B;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="64" y="111" width="1450" height="37" />
