          <mxGeometry as="geometry" x="48" y="1050" width="1500" height="24" />
        </mxCell>
        <mxCell id="start" value="&lt;b&gt;Entrada de loop()&lt;/b&gt;&lt;br&gt;&lt;br&gt;hotspotEmFoco()?&lt;br&gt;AP aberto + download ou HTTP &amp;lt;8 s" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E4F3F4;strokeColor=#167580;strokeWidth=1.5;fontColor=#17324F;fontFamily=Noto Sans;fontSize=17;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=12;spacingBottom=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="190" width="400" height="130" />
        </mxCell>
        <mxCell id="focus" value="&lt;b&gt;Foco HTTP / retorno&lt;/b&gt;&lt;br&gt;&lt;br&gt;Descartar bytes UART GPS&lt;br&gt;Alimentar WDT • delay 50 ms&lt;br&gt;Retornar sem etapas seguintes" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF2D9;strokeColor=#A36A15;strokeWidth=1.5;fontColor=#17324F;fontFamily=Noto Sans;fontSize=17;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=12;spacingBottom=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1090" y="190" width="440" height="150" />
        </mxCell>
        <mxCell id="acq" value="&lt;b&gt;GPS / MPU • janela 1 s&lt;/b&gt;&lt;br&gt;&lt;br&gt;receberGPS(c) • drenarFilaBLE()&lt;br&gt;MPU a cada 100 ms • WDT&lt;br&gt;vTaskDelay(1) por passagem" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EAF3FF;strokeColor=#2864A0;strokeWidth=1.5;fontColor=#17324F;fontFamily=Noto Sans;fontSize=17;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=12;spacingBottom=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="405" width="400" height="155" />
        </mxCell>
        <mxCell id="data" value="&lt;b&gt;Média + dados&lt;/b&gt;&lt;br&gt;&lt;br&gt;Média das amostras MPU&lt;br&gt;lerDHT() ≥2 s&lt;br&gt;newData → processarDadosGPS()" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EAF3FF;strokeColor=#2864A0;strokeWidth=1.5;fontColor=#17324F;fontFamily=Noto Sans;fontSize=17;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=12;spacingBottom=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="590" y="405" width="400" height="155" />
        </mxCell>
        <mxCell id="mode" value="&lt;b&gt;Modo / RF&lt;/b&gt;&lt;br&gt;&lt;br&gt;servicoModo(): poll WiFi&lt;br&gt;Fechar ciclo BLE+WiFi&lt;br&gt;Timers sono / inatividade AP" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F0ECFB;strokeColor=#7157A0;strokeWidth=1.5;fontColor=#17324F;fontFamily=Noto Sans;fontSize=17;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=12;spacingBottom=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1090" y="405" width="440" height="155" />
        </mxCell>
        <mxCell id="panel" value="&lt;b&gt;Resumo e fim&lt;/b&gt;&lt;br&gt;&lt;br&gt;Painel 5 s / 30 s com AP&lt;br&gt;Sem resumo em download&lt;br&gt;Guardar duração da volta" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EFF3F8;strokeColor=#354D6B;strokeWidth=1.5;fontColor=#17324F;fontFamily=Noto Sans;fontSize=17;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=12;spacingBottom=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="700" width="400" height="155" />
        </mxCell>
        <mxCell id="retry" value="&lt;b&gt;SD / retry pendente&lt;/b&gt;&lt;br&gt;&lt;br&gt;Qualquer buffer cheio → pendente&lt;br&gt;Retry ≥1 s; sem ciclo/scan/download&lt;br&gt;flushBuffers()" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E7F3ED;strokeColor=#287452;strokeWidth=1.5;fontColor=#17324F;fontFamily=Noto Sans;fontSize=17;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=12;spacingBottom=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="590" y="700" width="400" height="155" />
        </mxCell>
        <mxCell id="web" value="&lt;b&gt;Eventos HTTP&lt;/b&gt;&lt;br&gt;&lt;br&gt;imprimirAcessosWeb()&lt;br&gt;imprimirDownload()&lt;br&gt;Impressão só pela loopTask" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E4F3F4;strokeColor=#167580;strokeWidth=1.5;fontColor=#17324F;fontFamily=Noto Sans;fontSize=17;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=12;spacingBottom=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1090" y="700" width="440" height="155" />
