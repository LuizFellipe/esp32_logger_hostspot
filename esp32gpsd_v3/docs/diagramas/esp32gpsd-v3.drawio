        </mxCell>
        <mxCell id="kicker" value="ESP32 GPS LOGGER / V3 / ATLAS TÉCNICO" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=DejaVu Sans Mono;fontSize=14;fontColor=#2864A0;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="64" y="32" width="1450" height="25" />
        </mxCell>
        <mxCell id="title" value="Buffers, flush e recuperação do SD" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Ubuntu Sans;fontSize=30;fontColor=#17324F;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="64" y="61" width="1450" height="43" />
        </mxCell>
        <mxCell id="sub" value="Confirmação por arquivo/lote; não existe transação única envolvendo os três arquivos." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Noto Sans;fontSize=16;fontColor=#52667B;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="64" y="111" width="1450" height="37" />
        </mxCell>
        <mxCell id="footerline" value="" style="fillColor=#DCE4ED;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="48" y="1006" width="1504" height="1" />
        </mxCell>
        <mxCell id="source" value="Fonte: esp32gpsd_v3.ino:313–472, 831–878, 1536–1542" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=DejaVu Sans Mono;fontSize=13;fontColor=#52667B;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="48" y="1021" width="1500" height="25" />
        </mxCell>
        <mxCell id="scope" value="SENSOR  azul     RÁDIO  violeta     SD  verde     HTTP  petróleo     CONDIÇÃO / FALHA  âmbar  •  Snapshot 06/10/2026" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Noto Sans;fontSize=13;fontColor=#52667B;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="48" y="1050" width="1500" height="24" />
        </mxCell>
        <mxCell id="ram" value="&lt;b&gt;Acumular em RAM&lt;/b&gt;&lt;br&gt;&lt;br&gt;log: 150×160 B • WiFi/BLE: 50×256 B&lt;br&gt;Total: 49.600 B de buffers&lt;br&gt;Cheio → sobrescrever mais antiga + perdas" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E7F3ED;strokeColor=#287452;strokeWidth=1.5;fontColor=#17324F;fontFamily=Noto Sans;fontSize=17;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=12;spacingBottom=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="190" width="460" height="150" />
        </mxCell>
        <mxCell id="req" value="&lt;b&gt;Solicitar flush&lt;/b&gt;&lt;br&gt;&lt;br&gt;Qualquer buffer cheio ou&lt;br&gt;entrada HOTSPOT / SONO&lt;br&gt;flushPendente=true" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E7F3ED;strokeColor=#287452;strokeWidth=1.5;fontColor=#17324F;fontFamily=Noto Sans;fontSize=17;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=12;spacingBottom=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="570" y="190" width="460" height="150" />
        </mxCell>
        <mxCell id="gate" value="&lt;b&gt;Pode gravar agora?&lt;/b&gt;&lt;br&gt;&lt;br&gt;Sem scan WiFi/BLE e download&lt;br&gt;Adquirir sdMutex; checar download&lt;br&gt;Se bloqueado: manter pendente" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF2D9;strokeColor=#A36A15;strokeWidth=1.5;fontColor=#17324F;fontFamily=Noto Sans;fontSize=17;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=12;spacingBottom=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1080" y="190" width="460" height="150" />
        </mxCell>
        <mxCell id="write" value="&lt;b&gt;appendLinhasCirculares()&lt;/b&gt;&lt;br&gt;&lt;br&gt;log → wifi → ble; um open/close por lote&lt;br&gt;O_APPEND; ordem cronológica&lt;br&gt;Sem cópia intermediária do lote" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E7F3ED;strokeColor=#287452;strokeWidth=1.5;fontColor=#17324F;fontFamily=Noto Sans;fontSize=17;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=12;spacingBottom=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1080" y="440" width="460" height="150" />
        </mxCell>
        <mxCell id="ok" value="&lt;b&gt;Escrita + sync + close OK?&lt;/b&gt;&lt;br&gt;&lt;br&gt;Exigir tamanho exato por linha&lt;br&gt;Sucesso → remover lote daquele buffer&lt;br&gt;Falha → reter lote inteiro" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E7F3ED;strokeColor=#287452;strokeWidth=1.5;fontColor=#17324F;fontFamily=Noto Sans;fontSize=17;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=12;spacingBottom=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="570" y="440" width="460" height="150" />
        </mxCell>
        <mxCell id="success" value="&lt;b&gt;Todos os lotes confirmados&lt;/b&gt;&lt;br&gt;&lt;br&gt;Liberar mutex&lt;br&gt;flushPendente=false&lt;br&gt;Evento [OK ]" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E7F3ED;strokeColor=#287452;strokeWidth=1.5;fontColor=#17324F;fontFamily=Noto Sans;fontSize=17;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=12;spacingBottom=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="440" width="460" height="150" />
        </mxCell>
        <mxCell id="remount" value="&lt;b&gt;Falha: remontar cartão&lt;/b&gt;&lt;br&gt;&lt;br&gt;Ainda sob sdMutex: sd.end()&lt;br&gt;50 ms → sd.begin()&lt;br&gt;Sucesso zera falhasRemountSD" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF2D9;strokeColor=#A36A15;strokeWidth=1.5;fontColor=#17324F;fontFamily=Noto Sans;fontSize=17;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=12;spacingBottom=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="570" y="735" width="460" height="150" />
        </mxCell>
        <mxCell id="reset" value="&lt;b&gt;10 remounts falhos seguidos&lt;/b&gt;&lt;br&gt;&lt;br&gt;esp_restart()&lt;br&gt;Boot volta ao estado MOVIMENTO&lt;br&gt;RAM não gravada pode se perder" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF2D9;strokeColor=#A36A15;strokeWidth=1.5;fontColor=#17324F;fontFamily=Noto Sans;fontSize=17;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=12;spacingBottom=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1080" y="735" width="460" height="150" />
        </mxCell>
        <mxCell id="retry" value="&lt;b&gt;Retry no loop ≥1 s&lt;/b&gt;&lt;br&gt;&lt;br&gt;Manter pendente até confirmar&lt;br&gt;Sem ciclo/scan/download ativo&lt;br&gt;Retry pode duplicar escrita parcial" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF2D9;strokeColor=#A36A15;strokeWidth=1.5;fontColor=#17324F;fontFamily=Noto Sans;fontSize=17;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=12;spacingBottom=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="735" width="460" height="150" />
        </mxCell>
        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.7;strokeColor=#354D6B;fontFamily=Noto Sans;fontSize=13;fontColor=#17324F;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ram" target="req">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.7;strokeColor=#354D6B;fontFamily=Noto Sans;fontSize=13;fontColor=#17324F;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="req" target="gate">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e3" value="permitido" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.7;strokeColor=#287452;fontFamily=Noto Sans;fontSize=13;fontColor=#17324F;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="gate" target="write">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.7;strokeColor=#354D6B;fontFamily=Noto Sans;fontSize=13;fontColor=#17324F;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="write" target="ok">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e5" value="todos OK" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.7;strokeColor=#287452;fontFamily=Noto Sans;fontSize=13;fontColor=#17324F;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ok" target="success">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e6" value="algum falhou" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.7;strokeColor=#A36A15;fontFamily=Noto Sans;fontSize=13;fontColor=#17324F;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ok" target="remount">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e7" value="limite atingido" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.7;strokeColor=#A36A15;fontFamily=Noto Sans;fontSize=13;fontColor=#17324F;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="remount" target="reset">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e8" value="abaixo do limite" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.7;strokeColor=#A36A15;fontFamily=Noto Sans;fontSize=13;fontColor=#17324F;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="remount" target="retry">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e9" value="próxima tentativa" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.7;strokeColor=#A36A15;fontFamily=Noto Sans;fontSize=13;fontColor=#17324F;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=0.5;entryY=1;exitPerimeter=1;entryPerimeter=1;" edge="1" parent="1" source="retry" target="req">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="40" y="810" />
              <mxPoint x="40" y="650" />
              <mxPoint x="800" y="650" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="risk" value="Retenção do lote incerto preserva dados para retry; energia interrompida perde RAM. Flush falho não impede tentativa de abrir AP." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Noto Sans;fontSize=17;fontColor=#17324F;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="925" width="1480" height="45" />
        </mxCell>
