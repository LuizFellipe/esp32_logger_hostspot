        </mxCell>
        <mxCell id="i-title" value="SENSORES" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=DejaVu Sans Mono;fontSize=17;fontColor=#2864A0;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="576" y="187" width="449" height="30" />
        </mxCell>
        <mxCell id="c" value="" style="rounded=1;arcSize=4;fillColor=#E7F3ED;fillOpacity=35;strokeColor=#287452;strokeOpacity=35;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1068" y="175" width="484" height="660" />
        </mxCell>
        <mxCell id="c-title" value="COMPOSIÇÃO / CSV" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=DejaVu Sans Mono;fontSize=17;fontColor=#287452;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1086" y="187" width="448" height="30" />
        </mxCell>
        <mxCell id="parse" value="&lt;b&gt;UART → receberGPS()&lt;/b&gt;&lt;br&gt;&lt;br&gt;NMEA até 127 chars&lt;br&gt;gps.encode(): checksum&lt;br&gt;Aceita $GPRMC / $GPGGA" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EAF3FF;strokeColor=#2864A0;strokeWidth=1.5;fontColor=#17324F;fontFamily=Noto Sans;fontSize=17;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=12;spacingBottom=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="75" y="245" width="430" height="135" />
        </mxCell>
        <mxCell id="rmc" value="&lt;b&gt;RMC: velocidade / direção&lt;/b&gt;&lt;br&gt;&lt;br&gt;Campos numéricos e posição&lt;br&gt;knots ×1,852 → km/h&lt;br&gt;Velocidade válida → atualizarModo()" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EAF3FF;strokeColor=#2864A0;strokeWidth=1.5;fontColor=#17324F;fontFamily=Noto Sans;fontSize=17;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=12;spacingBottom=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="75" y="435" width="430" height="150" />
        </mxCell>
        <mxCell id="gga" value="&lt;b&gt;GGA: satélites / HDOP&lt;/b&gt;&lt;br&gt;&lt;br&gt;Atualiza leitura de posição&lt;br&gt;Não renova velocidade RMC&lt;br&gt;Sem velocidade nova: manter modo" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EAF3FF;strokeColor=#2864A0;strokeWidth=1.5;fontColor=#17324F;fontFamily=Noto Sans;fontSize=17;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=12;spacingBottom=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="75" y="635" width="430" height="145" />
        </mxCell>
        <mxCell id="mpu" value="&lt;b&gt;MPU6050&lt;/b&gt;&lt;br&gt;&lt;br&gt;Amostra a cada 100 ms&lt;br&gt;Média por janela de ≈1 s&lt;br&gt;Sem MPU: campos IMU vazios" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EAF3FF;strokeColor=#2864A0;strokeWidth=1.5;fontColor=#17324F;fontFamily=Noto Sans;fontSize=17;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=12;spacingBottom=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="585" y="245" width="430" height="135" />
        </mxCell>
        <mxCell id="dht" value="&lt;b&gt;DHT22&lt;/b&gt;&lt;br&gt;&lt;br&gt;Intervalo mínimo 2 s&lt;br&gt;NaN → campo CSV vazio&lt;br&gt;Última leitura alimenta página" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EAF3FF;strokeColor=#2864A0;strokeWidth=1.5;fontColor=#17324F;fontFamily=Noto Sans;fontSize=17;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=12;spacingBottom=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="585" y="435" width="430" height="150" />
        </mxCell>
        <mxCell id="units" value="&lt;b&gt;Unidades / freshness&lt;/b&gt;&lt;br&gt;&lt;br&gt;ac: m/s² • gy: rad/s&lt;br&gt;Velocidade CSV só se idade &amp;lt;3 s&lt;br&gt;Sensores pausam no foco HTTP" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF2D9;strokeColor=#A36A15;strokeWidth=1.5;fontColor=#17324F;fontFamily=Noto Sans;fontSize=17;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=12;spacingBottom=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="585" y="635" width="430" height="145" />
        </mxCell>
        <mxCell id="valid" value="&lt;b&gt;processarDadosGPS()&lt;/b&gt;&lt;br&gt;&lt;br&gt;Atualizar última posição válida&lt;br&gt;Validar data/hora/calendário&lt;br&gt;Normalizar UTC−3 com mktime" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E7F3ED;strokeColor=#287452;strokeWidth=1.5;fontColor=#17324F;fontFamily=Noto Sans;fontSize=17;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=12;spacingBottom=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1095" y="245" width="430" height="155" />
