        </mxCell>
        <mxCell id="source" value="Fonte: ../libraries/manifest.json; ../CONTEXT.md; ../docs/wiki/compilacao-arduino-cli.md" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=DejaVu Sans Mono;fontSize=13;fontColor=#52667B;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="48" y="1021" width="1500" height="25" />
        </mxCell>
        <mxCell id="scope" value="SENSOR  azul     RÁDIO  violeta     SD  verde     HTTP  petróleo     CONDIÇÃO / FALHA  âmbar  •  Snapshot 06/10/2026" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Noto Sans;fontSize=13;fontColor=#52667B;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="48" y="1050" width="1500" height="24" />
        </mxCell>
        <mxCell id="lib" value="&lt;b&gt;libraries/ • versões registradas&lt;/b&gt;&lt;br&gt;&lt;br&gt;TinyGPS 13.0.0 • SdFat 2.3.0 • DHT 1.4.7&lt;br&gt;MPU6050 2.2.9 • Unified Sensor 1.1.15&lt;br&gt;BusIO 1.17.4 • NimBLE-Arduino 2.5.0" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EFF3F8;strokeColor=#354D6B;strokeWidth=1.5;fontColor=#17324F;fontFamily=Noto Sans;fontSize=17;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=12;spacingBottom=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="65" y="200" width="700" height="175" />
        </mxCell>
        <mxCell id="core" value="&lt;b&gt;ESP32 Arduino Core 3.3.12&lt;/b&gt;&lt;br&gt;&lt;br&gt;WiFi / WebServer / NetworkClient&lt;br&gt;SPI / Wire / FreeRTOS / esp_task_wdt&lt;br&gt;Placa: esp32:esp32:esp32" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EFF3F8;strokeColor=#354D6B;strokeWidth=1.5;fontColor=#17324F;fontFamily=Noto Sans;fontSize=17;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=12;spacingBottom=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="835" y="200" width="700" height="175" />
        </mxCell>
        <mxCell id="sync" value="&lt;b&gt;Sincronizar projeto → IDE&lt;/b&gt;&lt;br&gt;&lt;br&gt;Na raiz esp32/:&lt;br&gt;python3 libraries/sync.py --apply&lt;br&gt;python3 libraries/sync.py --check&lt;br&gt;Divergência impede considerar build validado" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EFF3F8;strokeColor=#354D6B;strokeWidth=1.5;fontColor=#17324F;fontFamily=Noto Sans;fontSize=17;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=12;spacingBottom=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="65" y="450" width="700" height="175" />
        </mxCell>
        <mxCell id="compile" value="&lt;b&gt;Compilar v3 / no_ota&lt;/b&gt;&lt;br&gt;&lt;br&gt;arduino-cli compile&lt;br&gt;--fqbn esp32:esp32:esp32:PartitionScheme=no_ota&lt;br&gt;esp32gpsd_v3&lt;br&gt;Partição APP: 2.097.152 B; sem OTA" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EFF3F8;strokeColor=#354D6B;strokeWidth=1.5;fontColor=#17324F;fontFamily=Noto Sans;fontSize=17;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=12;spacingBottom=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="835" y="450" width="700" height="175" />
        </mxCell>
        <mxCell id="upload" value="&lt;b&gt;Gravar / monitorar&lt;/b&gt;&lt;br&gt;&lt;br&gt;Upload na porta correta com mesmo FQBN&lt;br&gt;Porta documentada: /dev/ttyACM0&lt;br&gt;Console Serial: 115200 baud&lt;br&gt;Porta precisa estar livre durante upload" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EAF3FF;strokeColor=#2864A0;strokeWidth=1.5;fontColor=#17324F;fontFamily=Noto Sans;fontSize=17;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=12;spacingBottom=12;" vertex="1" parent="1">
