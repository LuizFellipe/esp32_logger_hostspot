        <mxCell id="source" value="Fonte: esp32gpsd_v3.ino:162–199, 474–481, 595–609, 651–664, 1018–1067" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=DejaVu Sans Mono;fontSize=13;fontColor=#52667B;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="48" y="1021" width="1500" height="25" />
        </mxCell>
        <mxCell id="scope" value="SENSOR  azul     RÁDIO  violeta     SD  verde     HTTP  petróleo     CONDIÇÃO / FALHA  âmbar  •  Snapshot 06/10/2026" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Noto Sans;fontSize=13;fontColor=#52667B;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="48" y="1050" width="1500" height="24" />
        </mxCell>
        <mxCell id="log" value="&lt;b&gt;/log.txt • GPS + sensores&lt;/b&gt;&lt;br&gt;&lt;br&gt;Cabeçalho de 15 colunas:&lt;br&gt;data_hora, lat, lon, sat, hdop, kmh, direcao,&lt;br&gt;umidade, temp_dht, ac_x, ac_y, ac_z,&lt;br&gt;gy_x, gy_y, gy_z&lt;br&gt;Marcador: # BOOT bootCount=N reset_reason=R" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E7F3ED;strokeColor=#287452;strokeWidth=1.5;fontColor=#17324F;fontFamily=Noto Sans;fontSize=17;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=12;spacingBottom=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="65" y="215" width="700" height="220" />
        </mxCell>
        <mxCell id="wifi" value="&lt;b&gt;/wifi.txt • achados WiFi&lt;/b&gt;&lt;br&gt;&lt;br&gt;Sem cabeçalho • 7 colunas:&lt;br&gt;data_hora, lat, lon, SSID, RSSI, canal, criptografia&lt;br&gt;Dedup por hash do SSID&lt;br&gt;RSSI: dBm • segurança em texto" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F0ECFB;strokeColor=#7157A0;strokeWidth=1.5;fontColor=#17324F;fontFamily=Noto Sans;fontSize=17;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=12;spacingBottom=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="835" y="215" width="700" height="220" />
        </mxCell>
        <mxCell id="ble" value="&lt;b&gt;/ble.txt • achados BLE&lt;/b&gt;&lt;br&gt;&lt;br&gt;Sem cabeçalho • 7 colunas:&lt;br&gt;data_hora, lat, lon, MAC, nome, RSSI, tx_power&lt;br&gt;Nome / TX vazios se não anunciados&lt;br&gt;Posição/hora no consumo da fila, não no callback" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F0ECFB;strokeColor=#7157A0;strokeWidth=1.5;fontColor=#17324F;fontFamily=Noto Sans;fontSize=17;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=12;spacingBottom=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="65" y="505" width="700" height="200" />
        </mxCell>
        <mxCell id="units" value="&lt;b&gt;Representação / exportação&lt;/b&gt;&lt;br&gt;&lt;br&gt;DD/MM/AAAA HH:MM:SS • UTC−3 fixo&lt;br&gt;lat/lon ÷1.000.000 → graus decimais&lt;br&gt;km/h; umidade %; DHT °C; ac m/s²; gy rad/s&lt;br&gt;Downloads preservam bytes exatos do arquivo" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EAF3FF;strokeColor=#2864A0;strokeWidth=1.5;fontColor=#17324F;fontFamily=Noto Sans;fontSize=17;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=12;spacingBottom=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="835" y="505" width="700" height="200" />
        </mxCell>
        <mxCell id="heap" value="&lt;b&gt;RAM / heap volátil&lt;/b&gt;&lt;br&gt;&lt;br&gt;logBuffer: 24.000 B • WiFi: 12.800 B • BLE: 12.800 B.&lt;br&gt;Fila BLE: 10 ponteiros + records alocados dinamicamente.&lt;br&gt;Power-off perde dados não gravados." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF2D9;strokeColor=#A36A15;strokeWidth=1.5;fontColor=#17324F;fontFamily=Noto Sans;fontSize=17;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=12;spacingBottom=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="65" y="795" width="700" height="160" />
        </mxCell>
        <mxCell id="rtc" value="&lt;b&gt;RTC / flash / SD&lt;/b&gt;&lt;br&gt;&lt;br&gt;RTC: 2 caches ×500 hashes ×4 B + contadores de cache/boot.&lt;br&gt;Flash: firmware + PAGINA_CSS; não grava telemetria em SPIFFS.&lt;br&gt;SD: histórico CSV; não há rotação implementada." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EFF3F8;strokeColor=#354D6B;strokeWidth=1.5;fontColor=#17324F;fontFamily=Noto Sans;fontSize=17;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=12;spacingBottom=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="835" y="795" width="700" height="160" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
