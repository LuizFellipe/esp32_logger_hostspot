          <mxGeometry as="geometry" x="1183" y="175" width="369" height="760" />
        </mxCell>
        <mxCell id="shared-title" value="RECURSOS COMPARTILHADOS" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=DejaVu Sans Mono;fontSize=17;fontColor=#287452;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1201" y="187" width="333" height="30" />
        </mxCell>
        <mxCell id="stack" value="&lt;b&gt;WiFi + NimBLE&lt;/b&gt;&lt;br&gt;&lt;br&gt;Execução interna do core/IDF&lt;br&gt;Callback BLE: sem Serial / SD&lt;br&gt;Afinidade interna não definida aqui" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F0ECFB;strokeColor=#7157A0;strokeWidth=1.5;fontColor=#17324F;fontFamily=Noto Sans;fontSize=17;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=12;spacingBottom=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="73" y="245" width="390" height="170" />
        </mxCell>
        <mxCell id="queue" value="&lt;b&gt;Fila / flags BLE&lt;/b&gt;&lt;br&gt;&lt;br&gt;10 ponteiros → loopTask&lt;br&gt;bleFimPendente / bleScanAtivo&lt;br&gt;Falhas incrementam perdidos" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F0ECFB;strokeColor=#7157A0;strokeWidth=1.5;fontColor=#17324F;fontFamily=Noto Sans;fontSize=17;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=12;spacingBottom=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="73" y="610" width="390" height="150" />
        </mxCell>
        <mxCell id="loop" value="&lt;b&gt;loopTask&lt;/b&gt;&lt;br&gt;&lt;br&gt;Sensores / GPS / modos&lt;br&gt;Dona dos buffers e caches&lt;br&gt;Única emissora de Serial&lt;br&gt;Escrita SD + retry / remount" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EFF3F8;strokeColor=#354D6B;strokeWidth=1.5;fontColor=#17324F;fontFamily=Noto Sans;fontSize=17;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=12;spacingBottom=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="548" y="245" width="575" height="210" />
        </mxCell>
        <mxCell id="http" value="&lt;b&gt;Hotspot_HTTP&lt;/b&gt;&lt;br&gt;&lt;br&gt;Prioridade 2 • stack 8192 B&lt;br&gt;server.handleClient()&lt;br&gt;Tick 2 ms aberto / 100 ms fechado&lt;br&gt;Lê SD; publica métricas atômicas" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E4F3F4;strokeColor=#167580;strokeWidth=1.5;fontColor=#17324F;fontFamily=Noto Sans;fontSize=17;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=12;spacingBottom=12;" vertex="1" parent="1">
